# Anthropic API key — required to call /api/generate
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for generation.
# Defaults to claude-opus-4-7 (the latest Opus, highest quality for long
# creative prompts). Fallback when token budget matters: claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-opus-4-7
